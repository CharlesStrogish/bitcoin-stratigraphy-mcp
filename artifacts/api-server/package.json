    "@workspace/db": "workspace:*",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "nostr-tools": "2.25.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.6",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
