# Put the real value in Replit Secrets; never commit a filled-in .env file.
NWC_PAIRING_SECRET=
# Legacy PostgreSQL connection URL alias only. New Replit databases set DATABASE_URL.
REPLIT_DB=
# REST origin (the MCP SDK appends /mcp separately).
STRATIGRAPHY_SERVER_URL=https://bitcoin-stratigraphy-dashboard.replit.app
# Optional. Polling less often reduces wallet spending.
POLL_INTERVAL_MS=3600000