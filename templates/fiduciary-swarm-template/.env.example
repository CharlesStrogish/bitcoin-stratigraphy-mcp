# Model-provider secret. Never commit the completed .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Use a separate payer wallet with a small, explicit spending allowance.
NWC_URI=

# Independently trusted server Ed25519 SPKI public key, NOT a private key.
# Set the complete PEM as one quoted value with \n between lines.
# Obtain this public-key pin through your trusted operator channel.
FIDUCIARY_SERVER_PUBLIC_KEY=
