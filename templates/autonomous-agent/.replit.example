# Use at the root of a standalone Repl created from this template directory.
modules = ["nodejs-24"]
run = "pnpm install && pnpm build && pnpm start:seeder"

[deployment]
deploymentTarget = "vm"
ignorePorts = true
build = ["sh", "-c", "pnpm install --no-frozen-lockfile && pnpm build"]
run = ["sh", "-c", "NODE_ENV=production pnpm start:seeder"]