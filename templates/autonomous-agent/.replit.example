# Use at the root of a fork that includes sdk/typescript/ and templates/autonomous-agent/.
modules = ["nodejs-24"]
run = "pnpm install && pnpm --filter @bitcoin-stratigraphy/autonomous-agent-template dev"

[deployment]
deploymentTarget = "vm"
ignorePorts = true
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm --filter @bitcoin-stratigraphy/autonomous-agent-template build"]
run = ["sh", "-c", "NODE_ENV=production pnpm --filter @bitcoin-stratigraphy/autonomous-agent-template start"]