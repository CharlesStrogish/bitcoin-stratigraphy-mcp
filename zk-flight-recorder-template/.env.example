# REQUIRED: funded, scanner-scoped prepaid Macaroon. Never commit a real token.
L402_MACAROON=
# The current endpoint returns heuristic SHA-256 commitments, NOT Groth16 proofs.
SCANNER_URL=https://bitcoinstratigraphy.com/api/scanner
FLIGHT_RECORDER_DB=./private/flight-recorder.sqlite3
# false records event summaries only; true sends redacted inputs/outputs externally.
FLIGHT_RECORDER_CAPTURE_CONTENT=false
# true fails closed: the current scanner cannot satisfy a Groth16 requirement.
FLIGHT_RECORDER_REQUIRE_GROTH16=false
