modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]
run = "PORT=5000 pnpm --filter @workspace/api-server dev"

[deployment]
router = "application"
deploymentTarget = "gce"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cacert", "cargo", "freetype", "gitFull", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libtool", "libwebp", "libxcrypt", "openjpeg", "openssl", "opentimestamps-client", "pkg-config", "rustc", "tcl", "tk", "zlib"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 20948
externalPort = 3000

[userenv]

[userenv.development]
FIAT_MINT_PUBLIC_ORIGIN = "https://0dee9e2c-20d4-4b54-9d7a-4035b113f10f-00-34ffazbgk98cr.reed.replit.dev"
FIAT_MINT_STRIPE_PRICE_ID = "price_1Ua6EzBoEnKnBElMkG0uP6jl"
FIAT_MINT_WEBHOOK_ORIGIN = "https://bitcoinstratigraphy.com"

[userenv.production]
FIAT_MINT_PUBLIC_ORIGIN = "https://bitcoinstratigraphy.com"
FIAT_MINT_STRIPE_PRICE_ID = "price_1Ua6bWBpxRsmnukUUbIyNwoA"
FIAT_MINT_WEBHOOK_ORIGIN = "https://bitcoinstratigraphy.com"
