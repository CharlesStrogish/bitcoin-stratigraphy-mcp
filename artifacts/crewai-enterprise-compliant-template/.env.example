# Safe default: local MCP + local Slack mock only; no external API/LLM calls.
SWARM_MODE=demo
VIEWER_PORT=4173
# Optional Python executable if `python` is not the desired interpreter.
PYTHON=python

# Set SWARM_MODE=live explicitly to use the real endpoint and real Slack webhook.
MCP_URL=https://bitcoinstratigraphy.com/mcp
SWARM_WEBHOOK_URL=
# Exact server-issued Authorization value, e.g. L402 <macaroon>:<preimage>.
# Not interchangeable with the scanner key below. No automatic invoice payment.
MCP_AUTHORIZATION=

# Scanner entitlement for the viewer server ONLY. Never add a VITE_ prefix.
BITCOIN_STRATIGRAPHY_API_KEY=

# Only needed for `npm run start:agent` in live mode after successful MCP access.
OPENAI_API_KEY=
SWARM_MODEL=openai:gpt-4.1-mini
