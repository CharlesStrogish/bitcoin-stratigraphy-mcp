{
  "name": "workspace",
  "mcpName": "crstrogish/bitcoin-stratigraphy",
  "version": "2.1.3",
  "license": "(AGPL-3.0-only OR LicenseRef-Commercial)",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && node scripts/build-workspace.mjs",
    "build:npm": "node scripts/build-npm-release.mjs",
    "release:npm:check": "node scripts/check-npm-release.mjs",
    "release:check": "node scripts/check-published-assets.mjs",
    "format:check": "node scripts/check-format.mjs",
    "lint:python": "uv run --no-sync ruff check",
    "test": "node --test tests/*.test.mjs && pnpm -r --if-present run test",
    "test:python": "bash scripts/test-python.sh",
    "test:pipeline": "bash scripts/test-stratigraphy-coverage.sh",
    "test:e2e": "tsx scripts/test-e2e-master.ts",
    "test:l402": "pnpm exec tsx scripts/test-l402.ts",
    "test:dvm": "tsx scripts/test-dvm-client.ts",
    "test:mcp": "pnpm exec tsx scripts/test-mcp-health.ts",
    "test:nostr": "pnpm exec tsx scripts/test-nostr.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --filter \"./plugins/**\" --filter \"./templates/**\" --if-present run typecheck"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "@elizaos/core>crypto-browserify": "-",
      "@elizaos/core>pdfjs-dist": "6.2.108",
      "esbuild": "0.28.2",
      "fast-copy": "4.1.2",
      "fast-uri": "3.1.8",
      "handlebars": "4.7.10",
      "hono": "4.13.11",
      "js-yaml": "4.3.2",
      "markdown-it": "14.3.2",
      "nanoid@3": "3.3.18",
      "postcss-selector-parser": "7.1.6",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "source-map-js": "1.2.2",
      "underscore": "1.13.8",
      "follow-redirects@>=1.16.0 <1.16.1": "1.16.1"
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@replit/connectors-sdk": "^0.4.1",
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}
