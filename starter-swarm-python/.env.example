# Copy this file to .env. Never commit your filled-in .env.
# OpenAI API calls are billed separately from the Lightning circuit breaker.
OPENAI_API_KEY=paste_your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Your funded MAINNET LND node's HTTPS REST endpoint.
# Use a dedicated, low-balance wallet; this is not an NWC connection string.
LND_REST_URL=https://your-lnd-host:8080
# Paste the HEX-ENCODED macaroon authorized for paying and creating invoices.
# Prefer a restricted macaroon over your node's admin macaroon.
LND_MACAROON_HEX=paste_your_hex_encoded_lnd_macaroon_here
# Local certificate/CA file used to verify your node's TLS certificate.
# Leave blank only if its certificate is already trusted by your system.
LND_TLS_CERT_PATH=/absolute/path/to/your-lnd-tls.cert

# Required by SDK 1.1.0: obtain this Ed25519 SPKI PEM from the operator
# through an independently trusted channel and save it locally.
# Do NOT automatically trust a key downloaded from the API being verified.
STRATIGRAPHY_SERVER_PUBLIC_KEY_PATH=./server-public-key.pem

# Opt in for new deployments. If omitted, existing deployments stay on withdraw.
STRATIGRAPHY_YIELD_MODE="stake"  # Options: "stake" or "withdraw"
# Agent-owned Nostr BIP-340 identity, required for stake and get_escrow.
# Use a dedicated key. Never reuse the server's signing key or a wallet seed.
STRATIGRAPHY_NOSTR_PRIVATE_KEY=paste_your_32_byte_hex_nostr_private_key_here

# Optional dedicated NWC payer for clearing contract funding only.
# Keep your existing LND settings for data tools and yield withdrawals.
# Configure a low wallet-side spending budget AND routing-fee policy.
# WARNING: funding spends real sats; settlement is currently unavailable.
NWC_URI=
